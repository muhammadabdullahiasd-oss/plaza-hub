# Local API. Authentication/provider credentials are not configured.
PORT=4174
NODE_ENV=development

# Optional Stage 11 CLI override for an existing local PostgreSQL installation.
# The portable helper instead generates ../.local-postgres/connection.env.
# Replace the placeholder locally; never commit an actual password.
# LOCAL_DATABASE_URL=postgresql://local_user:replace_locally@127.0.0.1:55432/plazahub_dev

# Stage 12A preparation only. These values do not enable live login yet.
# Use a DEVELOPMENT project and its publishable key, never a service-role key.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
# SESSION_ENCRYPTION_KEY=replace_with_64_hex_random_characters
